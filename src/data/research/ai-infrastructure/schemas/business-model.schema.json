{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edubrainboost.github.io/SSID-docs/schemas/ai-infrastructure/business-model.schema.json",
  "title": "AI Infrastructure Business Model",
  "version": "2.1.0",
  "type": "object",
  "properties": {
    "catalog_id": { "type": "string", "const": "ai-infrastructure-business-models-100" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "const": "de" },
    "count": { "type": "integer", "const": 100 },
    "models": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "required": ["catalog_id", "title", "language", "count", "models"],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "SUPPORTED", "DOCUMENTED", "ESTIMATED", "INFERRED", "PLANNED", "ASSUMED", "UNKNOWN", "CONFLICT", "BLOCKED", "NOT_APPLICABLE", "STALE", "REJECTED"]
        },
        "sources": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "last_verified_utc": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 100 },
        "market": { "type": "string", "minLength": 1 },
        "pain_point": { "type": "string", "minLength": 1 },
        "ai_solution": { "type": "string", "minLength": 1 },
        "monetization": { "type": "string", "minLength": 1 },
        "market_comment": { "type": "string", "minLength": 1 },
        "maturity": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "DOCUMENTED", "INFERENCE", "UNKNOWN", "CONFLICT", "BLOCKED"]
        },
        "model_id": { "type": "string", "pattern": "^AI-INFRA-[0-9]{3}$" },
        "source_number": { "type": "integer", "minimum": 1, "maximum": 100 },
        "primary_cluster": { "type": "string" },
        "primary_cluster_label": { "type": "string" },
        "region": { "type": "array", "items": { "type": "string" } },
        "source_reference": {
          "type": "object",
          "properties": {
            "document": { "type": "string" },
            "page": { "type": "integer" },
            "section": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["document"],
          "additionalProperties": false
        },
        "economics_breakdown": {
          "type": "object",
          "properties": {
            "beneficiary": { "type": "string" },
            "payer": { "type": "string" },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "risk": {
          "type": "object",
          "properties": {
            "flag": { "type": ["string", "null"] },
            "categories": { "type": "array", "items": { "type": "string" } },
            "status": { "type": "string" }
          },
          "additionalProperties": false
        },
        "ssid_relevance": {
          "type": "object",
          "properties": {
            "dimensions": { "type": "object" },
            "fit_score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "status": { "type": "string" },
            "methodology_ref": { "type": "string" }
          },
          "additionalProperties": false
        },
        "infrastructure_pattern": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["marketplace", "network", "protocol", "platform", "orchestration_layer", "data_infrastructure", "physical_infrastructure", "hybrid", "unknown"]
            },
            "architecture": { "type": "string" },
            "coordination_model": { "type": "string" },
            "network_effect": { "type": "boolean" },
            "supply_side": { "type": "array", "items": { "type": "string" } },
            "demand_side": { "type": "array", "items": { "type": "string" } },
            "core_infrastructure": { "type": "string" },
            "critical_dependencies": { "type": "array", "items": { "type": "string" } },
            "scalability_pattern": { "type": "string" },
            "failure_modes": { "type": "array", "items": { "type": "string" } },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "market_sizing": {
          "type": "object",
          "properties": {
            "tam": { "$ref": "#/$defs/market_size" },
            "sam": { "$ref": "#/$defs/market_size" },
            "som": { "$ref": "#/$defs/market_size" },
            "currency": { "type": "string" },
            "base_year": { "type": "integer" },
            "target_year": { "type": "integer" },
            "methodology": { "type": "string" },
            "assumptions": { "type": "array", "items": { "type": "string" } },
            "geographic_scope": { "type": "array", "items": { "type": "string" } },
            "market_definition": { "type": "string" },
            "growth_rate": { "type": ["number", "null"] },
            "sources": { "type": "array", "items": { "type": "string" } },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "cold_start_strategy": {
          "type": "object",
          "properties": {
            "initial_wedge": { "type": "string" },
            "first_supply": { "type": "array", "items": { "type": "string" } },
            "first_demand": { "type": "array", "items": { "type": "string" } },
            "bootstrap_mechanism": { "type": "string" },
            "liquidity_strategy": { "type": "string" },
            "geographic_sequence": { "type": "array", "items": { "type": "string" } },
            "incentive_strategy": { "type": "string" },
            "trust_bootstrap": { "type": "string" },
            "minimum_viable_network": { "type": "string" },
            "activation_thresholds": { "type": "object" },
            "failure_conditions": { "type": "array", "items": { "type": "string" } },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "competitive_landscape": {
          "type": "object",
          "properties": {
            "direct_competitors": { "type": "array", "items": { "type": "string" } },
            "indirect_competitors": { "type": "array", "items": { "type": "string" } },
            "incumbent_alternatives": { "type": "array", "items": { "type": "string" } },
            "open_source_alternatives": { "type": "array", "items": { "type": "string" } },
            "internal_build_alternative": { "type": "string" },
            "differentiators": { "type": "array", "items": { "type": "string" } },
            "switching_costs": { "type": "string" },
            "barriers_to_entry": { "type": "array", "items": { "type": "string" } },
            "commoditization_risk": { "type": "string" },
            "competitive_intensity": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "data_and_integration_dependencies": {
          "type": "object",
          "properties": {
            "required_data": { "type": "array", "items": { "type": "string" } },
            "optional_data": { "type": "array", "items": { "type": "string" } },
            "data_providers": { "type": "array", "items": { "type": "string" } },
            "system_integrations": { "type": "array", "items": { "type": "string" } },
            "protocols": { "type": "array", "items": { "type": "string" } },
            "identity_dependencies": { "type": "array", "items": { "type": "string" } },
            "payment_dependencies": { "type": "array", "items": { "type": "string" } },
            "model_dependencies": { "type": "array", "items": { "type": "string" } },
            "latency_requirements": { "type": "string" },
            "availability_requirements": { "type": "string" },
            "data_quality_requirements": { "type": "string" },
            "data_residency": { "type": "string" },
            "vendor_lock_in": { "type": "string" },
            "integration_complexity": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "regulatory_constraints": {
          "type": "object",
          "properties": {
            "jurisdictions": { "type": "array", "items": { "type": "string" } },
            "regulated_activities": { "type": "array", "items": { "type": "string" } },
            "licensing_requirements": { "type": "string" },
            "data_protection": { "type": "string" },
            "consumer_protection": { "type": "string" },
            "competition_law": { "type": "string" },
            "employment_law": { "type": "string" },
            "tax": { "type": "string" },
            "payments": { "type": "string" },
            "financial_services": { "type": "string" },
            "sector_specific_rules": { "type": "string" },
            "cross_border_constraints": { "type": "string" },
            "required_legal_reviews": { "type": "array", "items": { "type": "string" } },
            "regulatory_risk": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "ai_vs_infrastructure_moat": {
          "type": "object",
          "properties": {
            "ai_dependency": { "type": "object" },
            "infrastructure_dependency": { "type": "object" },
            "data_moat": { "type": "string" },
            "workflow_moat": { "type": "string" },
            "network_moat": { "type": "string" },
            "distribution_moat": { "type": "string" },
            "regulatory_moat": { "type": "string" },
            "integration_moat": { "type": "string" },
            "switching_cost_moat": { "type": "string" },
            "model_substitutability": { "type": "string" },
            "open_source_substitution_risk": { "type": "string" },
            "infrastructure_replicability": { "type": "string" },
            "durability_score": { "type": "integer", "minimum": 0, "maximum": 10 },
            "rationale": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "market_maturity": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "enum": ["nascent", "emerging", "developing", "established", "mature", "declining", "fragmented", "unknown"]
            },
            "demand_maturity": { "type": "string" },
            "supply_maturity": { "type": "string" },
            "technology_maturity": { "type": "string" },
            "regulatory_maturity": { "type": "string" },
            "procurement_maturity": { "type": "string" },
            "integration_maturity": { "type": "string" },
            "standardization": { "type": "string" },
            "customer_education": { "type": "string" },
            "sales_cycle_maturity": { "type": "string" },
            "adoption_barriers": { "type": "array", "items": { "type": "string" } },
            "maturity_score": { "type": "integer", "minimum": 0, "maximum": 10 },
            "evidence": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": false
        },
        "evidence_status": { "$ref": "#/$defs/evidence" },
        "validation_atlas": {
          "type": "object",
          "properties": {
            "schema_validation": { "$ref": "#/$defs/validation_category" },
            "source_validation": { "$ref": "#/$defs/validation_category" },
            "economic_validation": { "$ref": "#/$defs/validation_category" },
            "technical_validation": { "$ref": "#/$defs/validation_category" },
            "market_validation": { "$ref": "#/$defs/validation_category" },
            "regulatory_validation": { "$ref": "#/$defs/validation_category" },
            "competitive_validation": { "$ref": "#/$defs/validation_category" },
            "integration_validation": { "$ref": "#/$defs/validation_category" },
            "risk_validation": { "$ref": "#/$defs/validation_category" },
            "cross_record_validation": { "$ref": "#/$defs/validation_category" },
            "overall_status": { "type": "string" },
            "validation_score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "blocking_findings": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "last_validated_utc": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id", "market", "pain_point", "ai_solution", "monetization", "market_comment", "maturity", "status",
        "infrastructure_pattern", "market_sizing", "cold_start_strategy", "competitive_landscape",
        "data_and_integration_dependencies", "regulatory_constraints", "ai_vs_infrastructure_moat",
        "market_maturity", "evidence_status", "validation_atlas"
      ],
      "additionalProperties": false
    },
    "market_size": {
      "type": "object",
      "properties": {
        "value": { "type": ["number", "null"] },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "status": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "validation_category": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "checks": { "type": "array", "items": { "type": "string" } },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "unknown": { "type": "integer" },
        "evidence": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
