{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edubrainboost.github.io/SSID-docs/schemas/ai-infrastructure/skill.schema.json",
  "title": "AI Agent Skill",
  "type": "object",
  "properties": {
    "catalog_id": { "type": "string", "const": "ai-agent-skills-100" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "const": "de" },
    "count": { "type": "integer", "const": 100 },
    "families": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"] },
          "name": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "required": ["catalog_id", "title", "language", "count", "families", "skills"],
  "additionalProperties": false,
  "$defs": {
    "skill": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 100 },
        "family": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs_outputs": { "type": "string", "minLength": 1 },
        "technologies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "model_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "business_model_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 100 },
          "uniqueItems": true
        },
        "implementation_note": { "type": "string" }
      },
      "required": ["id", "family", "name", "description", "inputs", "outputs", "inputs_outputs", "technologies", "model_types", "business_model_ids", "implementation_note"],
      "additionalProperties": false
    }
  }
}
